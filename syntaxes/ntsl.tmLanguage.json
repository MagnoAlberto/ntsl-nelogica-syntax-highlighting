{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nelogica NTSL",
  "scopeName": "source.ntsl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declaration-blocks" },
    { "include": "#control-keywords" },
    { "include": "#types" },
    { "include": "#built-in-series" },
    { "include": "#built-in-constants" },
    { "include": "#built-in-functions" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ntsl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.curly.ntsl",
          "begin": "\\{",
          "end": "\\}"
        },
        {
          "name": "comment.block.bracket-star.ntsl",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ntsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ntsl", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.ntsl",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.ntsl", "match": "''" }
          ]
        }
      ]
    },
    "declaration-blocks": {
      "patterns": [
        {
          "name": "keyword.declaration.ntsl",
          "match": "(?i)\\b(input|var|parameter|parametro|parametros)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.ntsl",
          "match": "(?i)\\b(begin|end|if|then|else|while|do|for|to|downto|repeat|until|break|continue|return|exit|try|except|finally)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ntsl",
          "match": "(?i)\\b(Integer|Float|Boolean|String|Serie|Array)\\b"
        }
      ]
    },
    "built-in-series": {
      "patterns": [
        {
          "name": "variable.language.series.ntsl",
          "match": "(?i)\\b(Open|Close|High|Low|Volume|Quantity|Date|Time|CurrentBar|CurrentAssetDate|LastBarOnChart|BarTimer|DailyClose|DailyHigh|DailyLow|DailyOpen|DailyVolume)\\b"
        }
      ]
    },
    "built-in-constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ntsl",
          "match": "(?i)\\b(True|False)\\b"
        },
        {
          "name": "support.constant.color.ntsl",
          "match": "(?i)\\b(clAmarelo|clVerde|clVermelho|clAzul|clBranco|clPreto|clCinza|clMarrom|clLaranja|clRosa|clRoxo|clAqua|clFuchsia|clLime|clNavy|clSilver|clTeal|clOlive|clMaroon)\\b"
        },
        {
          "name": "support.constant.style.ntsl",
          "match": "(?i)\\b(psSolid|psDash|psDot|psDashDot|psDashDotDot|tpTopRight|tpTopLeft|tpBottomRight|tpBottomLeft|tpCenter)\\b"
        }
      ]
    },
    "built-in-functions": {
      "patterns": [
        {
          "name": "support.function.trading.ntsl",
          "match": "(?i)\\b(LineSegment|Plot|Plot2|Plot3|Plot4|PlotLine|PaintBar|PlotText|SetPlotColor|SetPlotWidth|SetPlotStyle|BuyAtMarket|SellShortAtMarket|BuyStop|SellShortStop|BuyLimit|SellShortLimit|ClosePosition|ReversePosition|HasPosition|Position|AvgPrice|Round|Floor|Ceil|Abs|Min|Max|Sqrt|Power|ELDate_Consol|ELDate_AddDays|ELDate_Format|ELDate_Date|FormatFloat|FormatDate|FormatTime|Alert|PlaySound|Print)\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.ntsl" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ntsl",
          "match": "(?i)\\b(and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.assignment.ntsl",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.ntsl",
          "match": "(<>|<=|>=|=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.ntsl",
          "match": "(\\+|\\-|\\*|\\/)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ntsl",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ntsl",
          "match": "\\b\\d+\\b"
        }
      ]
    }
  }
}
